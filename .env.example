# Your private Telegram Bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram User/Chat ID (get it from @userinfobot or @raw_data_bot)
TELEGRAM_CHAT_ID=your_personal_telegram_chat_id_here

# Your Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: set this only on Vercel for a first-run smoke test, then remove it.
# Example: Sup, chief, I'm here to help you.
INITIAL_TELEGRAM_MESSAGE=

# Required only if testing locally to simulate Vercel security
CRON_SECRET=local_development_secret_only
